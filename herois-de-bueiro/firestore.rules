rules_version = '2';
// Regras do Heróis de Bueiro (Firestore). Publique em: Console do Firebase > Firestore > Regras.
service cloud.firestore {
  match /databases/{db}/documents {
    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function soMudou(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    // Administrador do site (conta Google do dono): lê e grava tudo, para restaurar backups.
    function admin() { return logado() && eu() == 'sjq4f37miIZHMhRo7kc8JIzSQgB3'; }
    match /{documento=**} {
      allow read, write: if admin();
    }

    // Perfil público (nome e foto) de cada conta.
    match /perfis/{uid} {
      allow read: if logado();
      allow write: if logado() && uid == eu();
    }

    // Heróis: o dono edita; o mestre (e quem tem o escudo) das campanhas do herói também.
    match /herois/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.dono == eu();
      allow update: if logado() && (resource.data.dono == eu() || eu() in resource.data.get('mestres', [])
                    || (!('dono' in resource.data) && request.resource.data.dono == eu()));
      allow delete: if logado() && resource.data.dono == eu();
    }

    // Vilões criados pela mesa: só o dono muda.
    match /viloes/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.dono == eu();
      allow update, delete: if logado() && resource.data.dono == eu();
    }

    // Campanhas: o mestre e quem tem o escudo mudam tudo (o cargo de mestre e a lista do escudo, só o mestre).
    // Jogadores só entram/saem, adicionam heróis e registram rolagens.
    match /campanhas/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.mestre == eu();
      allow update: if logado() && (
        resource.data.mestre == eu()
        || (eu() in resource.data.get('escudo', [])
            && request.resource.data.mestre == resource.data.mestre
            && request.resource.data.get('escudo', []) == resource.data.get('escudo', []))
        || (soMudou(['membros', 'herois', 'rolagens', 'combates', 'escudo', 'atualizado'])
            && request.resource.data.mestre == resource.data.mestre
            && request.resource.data.get('escudo', []).hasOnly(resource.data.get('escudo', []))
            && (eu() in request.resource.data.get('membros', []) || eu() in resource.data.get('membros', [])))
      );
      allow delete: if logado() && resource.data.mestre == eu();
    }
  }
}
